{
  "name": "custom-mahjong",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:acceptance": "vitest run web/acceptance/m2.acceptance.test.ts",
    "simulate:ai": "npm run build:engine && node scripts/ai-report.mjs",
    "test:watch": "vitest",
    "dev": "vite --config vite.config.ts",
    "start": "node --enable-source-maps dist-server/server/index.js",
    "build:engine": "tsc -p tsconfig.json",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:engine && npm run build:web && npm run build:server",
    "check:engine": "tsc -p tsconfig.json --noEmit",
    "check:web": "tsc -p tsconfig.web.json --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check": "npm run check:engine && npm run check:web && npm run check:server"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  }
}
