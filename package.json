{
  "name": "play-mahjong",
  "version": "1.0.0",
  "private": true,
  "description": "A custom-rules Mahjong game with local AI and authoritative multiplayer.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:fast": "vitest run --exclude src/ai-simulation.test.ts --exclude src/multiplayer.acceptance.test.ts --exclude server/server.test.ts",
    "test:integration": "vitest run src/ai-simulation.test.ts src/multiplayer.acceptance.test.ts server/server.test.ts",
    "test:acceptance": "vitest run web/acceptance/m2.acceptance.test.ts",
    "coverage": "vitest run --coverage",
    "simulate:ai": "npm run build:engine && node scripts/ai-report.mjs",
    "test:watch": "vitest",
    "dev": "vite --config vite.config.ts",
    "start": "node --enable-source-maps dist-server/server/index.js",
    "build:engine": "tsc -p tsconfig.json",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:engine && npm run build:web && npm run build:server",
    "check:engine": "tsc -p tsconfig.json --noEmit",
    "check:web": "tsc -p tsconfig.web.json --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check": "npm run check:engine && npm run check:web && npm run check:server",
    "format": "prettier --write \"src/**/*.ts\" \"web/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts}\" \".github/**/*.yml\"",
    "lint": "npm run format:check && node scripts/check-repo.mjs",
    "quality": "npm run lint && npm run check && npm run coverage && npm run test:acceptance && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mahjong",
    "typescript",
    "websocket",
    "game"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "ws": "^8.21.3"
  }
}
